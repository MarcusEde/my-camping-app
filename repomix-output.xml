        />
        <KpiCard
          icon={<Star size={14} />}
          label="Snittbetyg"
          value={stats.avgRating !== null ? stats.avgRating.toFixed(1) : "—"}
          subtitle={
            stats.feedbackCount > 0
              ? `${stats.feedbackCount} omdömen`
              : "Inga omdömen"
          }
          color="#d97706"
