              isOnSite
                ? "bg-emerald-100 text-emerald-600"
                : "bg-stone-100 text-stone-400"
            }`}
          >
            <Home size={14} strokeWidth={2} />
          </div>
          <div className="flex-1 text-left">
            <p className="text-xs font-semibold text-stone-700">
              På campingområdet
            </p>
            <p className="text-[10px] text-stone-400">
