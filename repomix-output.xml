"use client";

import type { RoadDistanceMap } from "@/lib/routing";
import type {
  Announcement,
  CachedPlace,
  Campground,
  InternalLocation,
} from "@/types/database";
import type { Lang, WeatherProp } from "@/types/guest";
import { AnimatePresence, motion } from "framer-motion";
import {
  AlertTriangle,
  Check,
  ChevronRight,
