          phone={s.phone}
          setPhone={s.setPhone}
          email={s.email}
          setEmail={s.setEmail}
          address={s.address}
          setAddress={s.setAddress}
          receptionHours={s.receptionHours}
          setReceptionHours={s.setReceptionHours}
          onSave={s.handleSave}
          isPending={s.isPending}
          saved={s.saved}
