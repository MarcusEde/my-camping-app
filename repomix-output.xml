    ?? ''
}

export function getOwnerNote(
  place: {
    owner_note?: string | null
    note_translations?: Record<string,
      string> | null
  },
  lang: Lang
): string | null {
  if (lang === 'sv') {
    return place.owner_note ?? null
  }
  const t = place
    .note_translations?.[lang]
  if (t && t.trim().length > 0) {
    return t
  }
  return place.owner_note ?? null
}
