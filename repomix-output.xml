];

/* ── Props ───────────────────────────────────────────── */
interface Props {
  campground: Campground;
}

/* ── Main Component ──────────────────────────────────── */
export default function SettingsForm({ campground }: Props) {
  const s = useSettingsForm({ campground });

  return (
    <div className="space-y-5">
      {/* ── TABS ── */}
      <div className="flex gap-1 rounded-full bg-stone-100/80 p-1">
