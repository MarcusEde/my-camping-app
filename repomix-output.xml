  brand: string;
  primaryColor: string;
  setPrimaryColor: (v: string) => void;
  heroImage: string;
  setHeroImage: (v: string) => void;
  logoImage: string;
  setLogoImage: (v: string) => void;
  heroImagePosition: string;
  setHeroImagePosition: (v: string) => void;
