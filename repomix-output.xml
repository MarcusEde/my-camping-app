          ) : (
            <ViewMode camp={camp} />
          )}

          {/* ── Actions ── */}
          <ActionBar
            isPending={s.isPending}
            onSync={s.handleSync}
            onClear={s.handleClear}
            onDelete={s.handleDelete}
          />
        </div>
      )}
    </div>
  );
}

