  const isOpen = hours.dotColor === "bg-emerald-500";
  const isClosedToday = hours.dotColor === "bg-red-400";
  return (
    <div className="flex items-center gap-2">
      <span className={`h-2 w-2 shrink-0 rounded-full ${hours.dotColor}`} />
