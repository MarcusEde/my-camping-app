          const meta =
            cat === "all" ? { emoji: "🗺️", label: "Alla" } : CATEGORY_META[cat];
          const isActive = filterCat === cat;
          const count = categoryCounts[cat] ?? 0;
          return (
            <button
              key={cat}
              onClick={() => onSelect(cat)}
