            label="Senaste synk"
            value={fmtRelative(camp.lastSyncedAt)}
          />
        </Section>
        <Section title="Plats & branding" borderLeft>
          <InfoPair
            label="Koordinater"
            value={`${camp.latitude}, ${camp.longitude}`}
