  const labels: Record<Lang, [string, string, string]> = {
    sv: ["God morgon på", "Välkommen till", "God kväll på"],
    en: ["Good morning at", "Welcome to", "Good evening at"],
    de: ["Guten Morgen auf", "Willkommen auf", "Guten Abend auf"],
