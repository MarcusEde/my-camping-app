}

/* ══════════════════════════════════════════════════════
   Section Components
   ══════════════════════════════════════════════════════ */

/* ── Branding Section ──────────────────────────────── */
function BrandingSection({
  brand,
  primaryColor,
  setPrimaryColor,
  heroImage,
  setHeroImage,
  logoImage,
  setLogoImage,
  heroImagePosition,
  setHeroImagePosition,
  onSave,
  isPending,
  saved,
