  lng?: number | null,
  name?: string,
): string | null {
  if (lat && lng)
    return `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
  if (name)
    return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(name)}`;
  return null;
