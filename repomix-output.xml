        </div>
        {!/^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/.test(primaryColor) && <p className="mt-1 px-1 text-[10px] font-bold text-red-500">Ogiltig färgkod (t.ex. #FFAA00).</p>}
