  });

  const brand = campground.primary_color || "#059669";
  const heroImage =
    campground.hero_image_url ||
    "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=800&q=80";

  const themeVars = {
    "--brand": brand,
    "--brand-10": `${brand}1A`,
